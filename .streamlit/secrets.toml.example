# Copy this file to  .streamlit/secrets.toml  and fill in YOUR values.
# secrets.toml is listed in .gitignore, so it is never uploaded to GitHub.

# Supabase Dashboard -> Project Settings -> API Keys  (or the green "Connect" button)
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"

# Use the PUBLIC key: the "Publishable key" (sb_publishable_...) - or, on older projects,
# the legacy "anon public" key (starts with eyJ...). Either works.
# NEVER put the service_role / secret key (sb_secret_...) here - the app refuses to start with it.
SUPABASE_ANON_KEY = "PASTE-YOUR-ANON-OR-PUBLISHABLE-KEY-HERE"

# Optional: only if Tesseract is installed somewhere unusual on Windows
# TESSERACT_CMD = "C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

# Optional (later): advanced AI parser - see core/ai_parser.py
# AI_PARSER = "claude"
# ANTHROPIC_API_KEY = "sk-ant-..."
